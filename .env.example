# Local mode needs no external services. Do not use real guest data in the open local host workspace.
DATA_MODE=local
# DEMO_DATA_DIR=.data

# For hosted mode: set DATA_MODE=supabase and provide all four values.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Generate once with: openssl rand -hex 32
# INVITATION_SECRET=YOUR_STABLE_RANDOM_SECRET
# Changing the secret invalidates link regeneration; preserve it across deployments.
